<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="diagnostic_details">问题详情</string>
    <string name="diagnostic_original">完整编译器诊断</string>
    <string name="diagnostic_unknown">编译器诊断</string>
    <string name="diagnostic_other_advice">请结合下方完整诊断查看具体原因；原文已保留，可复制排查。</string>
    <string name="diagnostic_unresolved">无法解析声明</string>
    <string name="diagnostic_unresolved_named">无法解析：%1$s</string>
    <string name="diagnostic_unresolved_advice">检查拼写、导入、声明作用域和已下载的项目依赖。</string>
    <string name="diagnostic_arguments">调用参数与声明不匹配</string>
    <string name="diagnostic_arguments_advice">对照方法或构造器声明检查参数的数量、顺序和类型；候选签名是备选项。</string>
    <string name="diagnostic_type_mismatch">值的类型不符合要求</string>
    <string name="diagnostic_type_mismatch_advice">在完整诊断中对比实际类型和所需类型；修正值或声明，不要直接添加不安全的强制转换。</string>
    <string name="diagnostic_syntax">语法不完整或不正确</string>
    <string name="diagnostic_syntax_advice">检查报错位置的括号、引号和语句结束符；完整诊断会指出缺少或多余的符号。</string>
    <string name="diagnostic_immutable">正在重新赋值不可变的值</string>
    <string name="diagnostic_immutable_advice">不可变的值只能初始化一次；只有确实需要后续修改且影响可控时，才调整声明。</string>
    <string name="diagnostic_initialization">缺少必要的初始化</string>
    <string name="diagnostic_initialization_advice">为属性、字段或变量提供初始值，并确保每条使用路径上都已赋值。</string>
    <string name="diagnostic_return">缺少必要的返回值</string>
    <string name="diagnostic_return_advice">在所有需要返回的分支中返回声明类型的值；若本就不应返回值，请核对返回类型。</string>
    <string name="diagnostic_override">重写声明与父类型不匹配</string>
    <string name="diagnostic_override_advice">对照父类型声明核对名称、参数和返回类型，再检查 override 关键字或注解。</string>
    <string name="diagnostic_final">无法继承或重写 final 声明</string>
    <string name="diagnostic_final_advice">确认设计上是否需要且允许继承或重写；不要只为消除报错就改动库的声明。</string>
    <string name="diagnostic_abstract">存在尚未实现的抽象成员</string>
    <string name="diagnostic_abstract_advice">实现所需成员；只有设计上不完整且不应被直接实例化的类，才考虑改为抽象类。</string>
    <string name="diagnostic_when">when 表达式未覆盖全部情况</string>
    <string name="diagnostic_when_advice">补齐缺少的分支；只有其余情况确实可共用一种处理方式时，才添加 else。</string>
    <string name="diagnostic_access">此处无法访问该声明</string>
    <string name="diagnostic_access_advice">检查可见性、包与模块边界，优先使用可访问的接口；只有拥有该声明且确需公开时才改可见性。</string>
    <string name="diagnostic_opt_in">此 API 需要显式选择启用</string>
    <string name="diagnostic_opt_in_advice">先了解实验性 API 的要求和下方列出的标记注解，再决定是否添加相应的 @OptIn。</string>
    <string name="diagnostic_inference">编译器无法推断类型</string>
    <string name="diagnostic_inference_advice">检查实参和重载；在信息不足的参数、变量或泛型位置显式写出类型。</string>
    <string name="diagnostic_duplicate">声明重复或相互冲突</string>
    <string name="diagnostic_duplicate_advice">检查声明名称、签名和导入；核对用法后，仅重命名或移除非预期的重复项。</string>
    <string name="diagnostic_modifier">修饰符在此处无效或相互冲突</string>
    <string name="diagnostic_modifier_advice">核对该声明允许的修饰符，移除重复或冲突项，不改动无关声明。</string>
    <string name="diagnostic_delegate">属性委托缺少必要的运算符</string>
    <string name="diagnostic_delegate_advice">检查委托类型及 getValue/setValue 运算符；Compose 委托也需核对相应导入。</string>
    <string name="diagnostic_deprecated">此 API 已弃用</string>
    <string name="diagnostic_deprecated_advice">查看声明或诊断建议的替代接口，确认行为兼容后再替换。</string>
    <string name="diagnostic_unused">声明尚未使用</string>
    <string name="diagnostic_unused_advice">删除前先核对引用和预期行为；未使用警告不一定会阻止编译。</string>
    <string name="diagnostic_static">在静态上下文中使用了实例成员</string>
    <string name="diagnostic_static_advice">使用所属类型的实例，或核对该成员是否确实应由所有实例共享；不要只为消除报错就添加 static。</string>
    <string name="diagnostic_exception">尚未处理受检异常</string>
    <string name="diagnostic_exception_advice">用合适的 try/catch 处理所列异常；若应由调用者处理，再考虑声明 throws。</string>
    <string name="diagnostic_language_level">此功能需要不同的 Java 源码级别</string>
    <string name="diagnostic_language_level_advice">核对模块的源码级别和编译器支持情况；只改显示的版本号不会启用该功能。</string>
</resources>
